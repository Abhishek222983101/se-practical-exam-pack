<mxfile host="app.diagrams.net" type="device"><diagram name="Q18 - FP &amp; COCOMO" id="d56"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1340" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="Q18. Online Pharmacy Management System – Function Points &amp;amp; Basic COCOMO" style="text;html=1;fontFamily=Helvetica;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1000" height="30" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;Question:&lt;/b&gt; A healthcare startup plans to develop an Online Pharmacy Management System (search medicines, upload prescriptions, orders, online payments, delivery tracking; pharmacists verify prescriptions, manage inventory, generate sales reports). Size = 32 KLOC, Semi-Detached. EI = 18, EO = 14, EQ = 10, ILF = 8, EIF = 5; all average complexity; VAF = 1.05.&lt;br&gt;1. Calculate UFP. 2. Calculate AFP. 3. Calculate effort using Basic COCOMO (a = 2.4, b = 1.05, c = 2.5, d = 0.38). 4. Find the estimated effort and discuss whether the project is suitable for the selected COCOMO category." style="text;html=1;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;spacing=4;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1000" height="120" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;Given:&lt;/b&gt;&lt;br&gt;• Size = 32 KLOC &amp;nbsp;&amp;nbsp;• Category = Semi-Detached &amp;nbsp;&amp;nbsp;• VAF = 1.05 &amp;nbsp;&amp;nbsp;• All functions = Average complexity&lt;br&gt;• EI = 18, EO = 14, EQ = 10, ILF = 8, EIF = 5&lt;br&gt;• a = 2.4, b = 1.05, c = 2.5, d = 0.38" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="1000" height="100" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Formulas:&lt;/b&gt;&lt;br&gt;• UFP = Σ (Count × Weight) &amp;nbsp;&amp;nbsp;• AFP = UFP × VAF&lt;br&gt;• E = a × (KLOC)&lt;sup&gt;b&lt;/sup&gt; PM &amp;nbsp;&amp;nbsp;• D = c × (E)&lt;sup&gt;d&lt;/sup&gt; months &amp;nbsp;&amp;nbsp;• Staff = E / D" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="310" width="1000" height="80" as="geometry"/></mxCell><mxCell id="n6" value="1. Unadjusted Function Points (UFP)  –  average weights: EI 4, EO 5, EQ 4, ILF 10, EIF 7" style="text;html=1;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;spacing=0;fontStyle=5;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="1000" height="20" as="geometry"/></mxCell><mxCell id="n7" value="Function Type" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#E6E6E6;fontColor=#000000;fontStyle=1;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="380" height="30" as="geometry"/></mxCell><mxCell id="n8" value="Count" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#E6E6E6;fontColor=#000000;fontStyle=1;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="430" width="180" height="30" as="geometry"/></mxCell><mxCell id="n9" value="Average Weight" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#E6E6E6;fontColor=#000000;fontStyle=1;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="430" width="200" height="30" as="geometry"/></mxCell><mxCell id="n10" value="Count × Weight" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#E6E6E6;fontColor=#000000;fontStyle=1;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="430" width="240" height="30" as="geometry"/></mxCell><mxCell id="n11" value="External Inputs (EI)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="460" width="380" height="30" as="geometry"/></mxCell><mxCell id="n12" value="18" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="460" width="180" height="30" as="geometry"/></mxCell><mxCell id="n13" value="4" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="460" width="200" height="30" as="geometry"/></mxCell><mxCell id="n14" value="72" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="460" width="240" height="30" as="geometry"/></mxCell><mxCell id="n15" value="External Outputs (EO)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="380" height="30" as="geometry"/></mxCell><mxCell id="n16" value="14" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="490" width="180" height="30" as="geometry"/></mxCell><mxCell id="n17" value="5" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="490" width="200" height="30" as="geometry"/></mxCell><mxCell id="n18" value="70" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="490" width="240" height="30" as="geometry"/></mxCell><mxCell id="n19" value="External Inquiries (EQ)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="380" height="30" as="geometry"/></mxCell><mxCell id="n20" value="10" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="520" width="180" height="30" as="geometry"/></mxCell><mxCell id="n21" value="4" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="520" width="200" height="30" as="geometry"/></mxCell><mxCell id="n22" value="40" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="520" width="240" height="30" as="geometry"/></mxCell><mxCell id="n23" value="Internal Logical Files (ILF)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="550" width="380" height="30" as="geometry"/></mxCell><mxCell id="n24" value="8" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="550" width="180" height="30" as="geometry"/></mxCell><mxCell id="n25" value="10" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="550" width="200" height="30" as="geometry"/></mxCell><mxCell id="n26" value="80" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="550" width="240" height="30" as="geometry"/></mxCell><mxCell id="n27" value="External Interface Files (EIF)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="580" width="380" height="30" as="geometry"/></mxCell><mxCell id="n28" value="5" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="580" width="180" height="30" as="geometry"/></mxCell><mxCell id="n29" value="7" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="580" width="200" height="30" as="geometry"/></mxCell><mxCell id="n30" value="35" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="580" width="240" height="30" as="geometry"/></mxCell><mxCell id="n31" value="Total UFP" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="610" width="380" height="30" as="geometry"/></mxCell><mxCell id="n32" value="" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="420" y="610" width="180" height="30" as="geometry"/></mxCell><mxCell id="n33" value="" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="600" y="610" width="200" height="30" as="geometry"/></mxCell><mxCell id="n34" value="297" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="800" y="610" width="240" height="30" as="geometry"/></mxCell><mxCell id="n35" value="2. Adjusted Function Points (AFP)" style="text;html=1;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;spacing=0;fontStyle=5;" vertex="1" parent="1"><mxGeometry x="40" y="660" width="1000" height="20" as="geometry"/></mxCell><mxCell id="n36" value="AFP = UFP × VAF = 297 × 1.05 = &lt;b&gt;311.85 FP ≈ 312 FP&lt;/b&gt;" style="text;html=1;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;spacing=4;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="1000" height="40" as="geometry"/></mxCell><mxCell id="n37" value="3. Basic COCOMO (given constants, size = 32 KLOC)" style="text;html=1;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;spacing=0;fontStyle=5;" vertex="1" parent="1"><mxGeometry x="40" y="740" width="1000" height="20" as="geometry"/></mxCell><mxCell id="n38" value="&lt;b&gt;Effort:&lt;/b&gt; E = 2.4 × (32)&lt;sup&gt;1.05&lt;/sup&gt; = 2.4 × 38.05 = &lt;b&gt;91.33 person-months&lt;/b&gt;&lt;br&gt;&lt;b&gt;Time:&lt;/b&gt; D = 2.5 × (91.33)&lt;sup&gt;0.38&lt;/sup&gt; = 2.5 × 5.56 = &lt;b&gt;13.90 months&lt;/b&gt;&lt;br&gt;&lt;b&gt;Staff:&lt;/b&gt; N = 91.33 / 13.90 = 6.57 ≈ &lt;b&gt;7 persons&lt;/b&gt;" style="text;html=1;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;spacing=4;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="40" y="770" width="1000" height="80" as="geometry"/></mxCell><mxCell id="n39" value="4. Estimated Effort &amp;amp; Suitability of the Category" style="text;html=1;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;spacing=0;fontStyle=5;" vertex="1" parent="1"><mxGeometry x="40" y="860" width="1000" height="20" as="geometry"/></mxCell><mxCell id="n40" value="• Estimated effort ≈ &lt;b&gt;91.33 PM&lt;/b&gt; (≈ 13.9 months with ≈ 7 people), using the constants supplied in the question.&lt;br&gt;• The given constants (2.4, 1.05, 2.5, 0.38) are actually the &lt;b&gt;Organic&lt;/b&gt; constants. Standard &lt;b&gt;Semi-Detached&lt;/b&gt; constants (a = 3.0, b = 1.12, c = 2.5, d = 0.35) give E = 3.0 × 32&lt;sup&gt;1.12&lt;/sup&gt; = &lt;b&gt;145.51 PM&lt;/b&gt; and D = &lt;b&gt;14.29 months&lt;/b&gt; (≈ 10 persons).&lt;br&gt;• Semi-Detached suits a medium-size project with a mixed-experience team and moderately complex requirements. This system (prescriptions, payments, delivery, inventory) fits that, so the category is &lt;b&gt;suitable&lt;/b&gt;, although 32 KLOC is on the smaller side.&lt;br&gt;• Hence the realistic estimate is the higher Semi-Detached value; the Organic result is a lower bound." style="text;html=1;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;spacing=4;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="40" y="890" width="1000" height="140" as="geometry"/></mxCell><mxCell id="n41" value="Final Answers" style="text;html=1;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;spacing=0;fontStyle=5;" vertex="1" parent="1"><mxGeometry x="40" y="1040" width="1000" height="20" as="geometry"/></mxCell><mxCell id="n42" value="Question" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#E6E6E6;fontColor=#000000;fontStyle=1;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1070" width="360" height="30" as="geometry"/></mxCell><mxCell id="n43" value="Answer" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#E6E6E6;fontColor=#000000;fontStyle=1;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="1070" width="640" height="30" as="geometry"/></mxCell><mxCell id="n44" value="1. UFP" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1100" width="360" height="30" as="geometry"/></mxCell><mxCell id="n45" value="297" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="1100" width="640" height="30" as="geometry"/></mxCell><mxCell id="n46" value="2. AFP" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1130" width="360" height="30" as="geometry"/></mxCell><mxCell id="n47" value="311.85 FP ≈ 312 FP" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="1130" width="640" height="30" as="geometry"/></mxCell><mxCell id="n48" value="3. Estimated effort" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1160" width="360" height="30" as="geometry"/></mxCell><mxCell id="n49" value="91.33 person-months" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="1160" width="640" height="30" as="geometry"/></mxCell><mxCell id="n50" value="3. Development time" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1190" width="360" height="30" as="geometry"/></mxCell><mxCell id="n51" value="13.90 months" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="1190" width="640" height="30" as="geometry"/></mxCell><mxCell id="n52" value="3. Average team size" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1220" width="360" height="30" as="geometry"/></mxCell><mxCell id="n53" value="≈ 7 persons" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="1220" width="640" height="30" as="geometry"/></mxCell><mxCell id="n54" value="4. Suitability" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1250" width="360" height="30" as="geometry"/></mxCell><mxCell id="n55" value="Semi-Detached is suitable (standard constants → 145.51 PM, 14.29 months)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="1250" width="640" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>