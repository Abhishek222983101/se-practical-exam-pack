enance" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="790" y="530" width="220" height="60" as="geometry"/></mxCell><mxCell id="e63" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;html=1;fontFamily=Helvetica;fontSize=12;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n57" target="n58"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e64" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;html=1;fontFamily=Helvetica;fontSize=12;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n58" target="n59"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e65" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;html=1;fontFamily=Helvetica;fontSize=12;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n59" target="n60"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e66" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;html=1;fontFamily=Helvetica;fontSize=12;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n60" target="n61"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e67" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;html=1;fontFamily=Helvetica;fontSize=12;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n61" target="n62"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n68" value="Each phase must be completed and approved before the next begins" style="text;html=1;fontFamily=Helvetica;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="900" height="30" as="geometry"/></mxCell><mxCell id="n69" value="&lt;b&gt;Why Waterfall is suitable&lt;/b&gt;&lt;br&gt;• Requirements are clear and stable.&lt;br&gt;• Needs strong documentation and review after every phase.&lt;br&gt;• Changes are not expected, so Waterfall's rigidity is acceptable." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1000" y="80" width="360" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Q13 – Practical: Waterfall" id="d220"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n70" value="Q13 – Hospital Management System: Waterfall Model" style="text;html=1;fontFamily=Helvetica;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1240" height="30" as="geometry"/></mxCell><mxCell id="n71" value="Requirement Analysis" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="220" height="60" as="geometry"/></mxCell><mxCell id="n72" value="Design" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="190" y="170" width="220" height="60" as="geometry"/></mxCell><mxCell id="n73" value="Implementation" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="260" width="220" height="60" as="geometry"/></mxCell><mxCell id="n74" value="Testing" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="490" y="350" width="220" height="60" as="geometry"/></mxCell><mxCell id="n75" value="Deployment" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="440" width="220" height="60" as="geometry"/></mxCell><mxCell id="n76" value="Maintenance" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="790" y="530" width="220" height="60" as="geometry"/></mxCell><mxCell id="e77" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;html=1;fontFamily=Helvetica;fontSize=12;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n71" target="n72"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e78" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;html=1;fontFamily=Helvetica;fontSize=12;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n72" target="n73"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e79" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;html=1;fontFamily=Helvetica;fontSize=12;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n73" target="n74"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e80" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;html=1;fontFamily=Helvetica;fontSize=12;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n74" target="n75"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e81" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;html=1;fontFamily=Helvetica;fontSize=12;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n75" target="n76"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n82" value="Linear, sequential: each phase finishes before the next begins" style="text;html=1;fontFamily=Helvetica;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="900" height="30" as="geometry"/></mxCell><mxCell id="n83" value="&lt;b&gt;Why Waterfall is suitable&lt;/b&gt;&lt;br&gt;• Clearly defined requirements – all modules known in advance.&lt;br&gt;• Stable requirements – major changes not expected.&lt;br&gt;• Security &amp;amp; reliability via a structured process.&lt;br&gt;• Proper documentation for hospital operations / compliance.&lt;br&gt;• Easy management through clear phases and milestones." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1000" y="80" width="360" height="260" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>