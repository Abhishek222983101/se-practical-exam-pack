n129" value="Risk handled" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#E6E6E6;fontColor=#000000;fontStyle=1;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1140" y="400" width="300" height="40" as="geometry"/></mxCell><mxCell id="n130" value="Spiral 1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="440" width="100" height="40" as="geometry"/></mxCell><mxCell id="n131" value="Application structure and login" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="440" width="340" height="40" as="geometry"/></mxCell><mxCell id="n132" value="Authentication risks" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1140" y="440" width="300" height="40" as="geometry"/></mxCell><mxCell id="n133" value="Spiral 2" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="480" width="100" height="40" as="geometry"/></mxCell><mxCell id="n134" value="Balance enquiry and fund transfer" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="480" width="340" height="40" as="geometry"/></mxCell><mxCell id="n135" value="Transaction failure, data security" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1140" y="480" width="300" height="40" as="geometry"/></mxCell><mxCell id="n136" value="Spiral 3" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="