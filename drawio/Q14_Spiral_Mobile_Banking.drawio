tml=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="430" y="140" width="220" height="50" as="geometry"/></mxCell><mxCell id="n90" value="3. Develop &amp;amp; verify&lt;br&gt;next-level product" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="430" y="750" width="220" height="50" as="geometry"/></mxCell><mxCell id="n91" value="4. Plan the next phase&lt;br&gt;(review &amp;amp; commit)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="110" y="750" width="220" height="50" as="geometry"/></mxCell><mxCell id="n92" value="Concept of operation" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="410" y="350" width="140" height="40" as="geometry"/></mxCell><mxCell id="n93" value="Risk analysis +&lt;br&gt;Prototype 1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="470" y="270" width="140" height="40" as="geometry"/></mxCell><mxCell id="n94" value="Code &amp;amp; unit test" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="540" y="200" width="140" height="40" as="geometry"/></mxCell><mxCell id="n95" value="Requirements plan" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="190" y="560" width="140" height="40" as="geometry"/></mxCell><mxCell id="n96" value="Detailed design,&lt;br&gt;Prototype 2" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="130" y="630" width="140" height="40" as="geometry"/></mxCell><mxCell id="n97" value="Integration, test&lt;br&gt;&amp;amp; release" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="700" width="140" height="40" as="geometry"/></mxCell><mxCell id="n98" value="Radius = cumulative cost, angle = progress; each loop passes through all four quadrants" style="text;html=1;fontFamily=Helvetica;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="60" y="880" width="640" height="30" as="geometry"/></mxCell><mxCell id="n99" value="&lt;b&gt;Why the Spiral Model is suitable&lt;/b&gt;&lt;br&gt;• Every loop has a risk-analysis step – vital for security and fraud.&lt;br&gt;• Prototypes are tested repeatedly before release.&lt;br&gt;• Built in stages with a go / no-go review each loop." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="760" y="80" width="680" height="170" as="geometry"/></mxCell><mxCell id="n100" value="&lt;b&gt;Application of spirals&lt;/b&gt;" style="text;html=1;fontFamily=Helvetica;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;spacing=0;" vertex="1" parent="1"><mxGeometry x="760" y="280" width="680" height="30" as="geometry"/></mxCell><mxCell id="n101" value="Spiral" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#E6E6E6;fontColor=#000000;fontStyle=1;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="310" width="100" height="40" as="geometry"/></mxCell><mxCell id="n102" value="Module developed" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#E6E6E6;fontColor=#000000;fontStyle=1;strokeColo