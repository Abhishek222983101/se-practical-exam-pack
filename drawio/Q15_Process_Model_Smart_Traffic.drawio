=wrap;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="680" width="600" height="30" as="geometry"/></mxCell><mxCell id="n203" value="&lt;b&gt;Why the Agile Model is suitable&lt;/b&gt;&lt;br&gt;• Evolving requirements: adapts to changing traffic conditions and needs.&lt;br&gt;• AI integration: continuous improvement of AI models.&lt;br&gt;• IoT integration: frequent testing / updates of sensors and signals.&lt;br&gt;• Fast delivery: working modules in short sprints.&lt;br&gt;• Continuous feedback from the city corporation." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="700" y="80" width="740" height="260" as="geometry"/></mxCell><mxCell id="n204" value="&lt;b&gt;Application of sprints&lt;/b&gt;" style="text;html=1;fontFamily=Helvetica;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;spacing=0;" vertex="1" parent="1"><mxGeometry x="700" y="370" width="740" height="30" as="geometry"/></mxCell><mxCell id="n205" value="Sprint" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#E6E6E6;fontColor=#000000;fontStyle=1;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="400" width="110" height="40" as="geometry"/></mxCell><mxCell id="n206" value="Module developed" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#E6E6E6;fontColor=#000000;fontStyle=1;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="810" y="400" width="630" height="40" as="geometry"/></mxCell><mxCell id="n207" value="Sprint 1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="440" width="110" height="40" as="geometry"/></mxCell><mxCell id="n208" value="Traffic monitoring using cameras and sensors" style="rounded