n97" value="R3" style="text;html=1;fontFamily=Helvetica;align=center;verticalAlign=middle;fontSize=12;fontStyle=3;" vertex="1" parent="1"><mxGeometry x="740" y="130" width="40" height="20" as="geometry"/></mxCell><mxCell id="n98" value="Fig. Q10 – CFG (N = 6, E = 7)" style="text;html=1;fontFamily=Helvetica;align=center;verticalAlign=middle;fontSize=12;fontStyle=2;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="400" y="570" width="360" height="24" as="geometry"/></mxCell><mxCell id="n99" value="2. Cyclomatic Complexity V(G)" style="text;html=1;fontFamily=Helvetica;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="800" y="70" width="560" height="24" as="geometry"/></mxCell><mxCell id="n100" value="&lt;b&gt;Formula:&lt;/b&gt; V(G) = E − N + 2P &amp;nbsp;&amp;nbsp;(P = connected components = 1)&lt;br&gt;&lt;br&gt;Number of edges &amp;nbsp;&amp;nbsp;E = 7&lt;br&gt;Number of nodes &amp;nbsp;&amp;nbsp;N = 6&lt;br&gt;Predicate (decision) nodes = 2 &amp;nbsp;(while at node 2, if at node 3)&lt;br&gt;Regions R = 3 &amp;nbsp;(R1, R2 inside the graph + R3 outside)&lt;br&gt;&lt;br&gt;&lt;b&gt;Method 1:&lt;/b&gt; V(G) = E − N + 2 = 7 − 6 + 2 = &lt;b&gt;3&lt;/b&gt;&lt;br&gt;&lt;b&gt;Method 2:&lt;/b&gt; V(G) = Predicate nodes + 1 = 2 + 1 = &lt;b&gt;3&lt;/b&gt;&lt;br&gt;&lt;b&gt;Method 3:&lt;/b&gt; V(G) = Number of regions = &lt;b&gt;3&lt;/b&gt;&lt;br&gt;&lt;br&gt;All three methods give &lt;b&gt;V(G) = 3&lt;/b&gt;." style="text;html=1;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;spacing=2;" vertex="1" parent="1"><mxGeometry x="800" y="100" width="560" height="250" as="geometry"/></mxCell><mxCell id="n101" value="3. Independent Paths (Basis Set) and 4. Test Cases" style="text;html=1;fontFamily=Helvetica;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="800" y="370" width="560" height="24" as="geometry"/></mxCell><mxCell id="n102" value="Path" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#E6E6E6;fontColor=#000000;fontStyle=1;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="400" width="60" height="30" as="geometry"/></mxCell><mxCell id="n103" value="Nodes traversed" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#E6E6E6;fontColor=#000000;fontStyle=1;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="860" y="400" width="210" height="30" as="geometry"/></mxCell><mxCell id="n104" value="Test input" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#E6E6E6;fontColor=#000000;fontStyle=1;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1070" y="400" width="130" height="30" as="geometry"/></mxCell><mxCell id="n105" value="Expected output" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#E6E6E6;fontColor=#000000;fontStyle=1;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1200" y="400" width="160" height="30" as="geometry"/></mxCell><mxCell id="n106" value="P1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="430" width="60" height="30" as="geometry"/></mxCell><mxCell id="n107" value="1 → 2 → 6 (loop skipped)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="860" y="430" width="210" height="30" as="geometry"/></mxCell><mxCell id="n108" value="n = 3" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1070" y="430" width="130" height="30" as="geometry"/></mxCell><mxCell id="n109" value="true" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex=