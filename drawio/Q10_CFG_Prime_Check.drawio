ica;fontSize=11;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1" source="n144" target="n145"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint x="-10" y="-6" as="offset"/></mxGeometry></mxCell><mxCell id="e153" value="F" style="endArrow=block;endFill=1;endSize=6;html=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1" source="n144" target="n148"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint x="12" y="0" as="offset"/><Array as="points"><mxPoint x="720" y="290"/><mxPoint x="720" y="560"/></Array></mxGeometry></mxCell><mxCell id="e154" value="T" style="endArrow=block;endFill=1;endSize=6;html=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1" source="n145" target="n147"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint x="-10" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e155" value="F" style="endArrow=block;endFill=1;endSize=6;html=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1" source="n145" target="n146"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint x="0" y="12" as="offset"/></mxGeometry></mxCell><mxCell id="e156" value="loop back" style="endArrow=block;endFill=1;endSize=6;html=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n146" target="n144"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint x="34" y="-6" as="offset"/></mxGeometry></mxCell><mxCell id="e157" value="break" style="endArrow=block;endFill=1;endSize=6;html=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n147" target="n148"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint x="-26" y="6" as="offset"/></mxGeometry></mxCell><mxCell id="e158" value="" style="endArrow=block;endFill=1;endSize=6;html=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n148" target="n149"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n159" value="R1" style="text;html=1;fontFamily=Helvetica;align=center;verticalAlign=middle;fontSize=12;fontStyle=3;" vertex="1" parent="1"><mxGeometry x="540" y="340" width="40" height="20" as="geometry"/></mxCell><mxCell id="n160" value="R2" style="text;html=1;fontFamily=Helvetica;align=center;verticalAlign=middle;fontSize=12;fontStyle=3;" vertex="1" parent="1"><mxGeometry x="610" y="460" width="40" height="20" as="geometry"/></mxCell><mxCell id="n161" value="R3" style="text;html=1;fontFamily=Helvetica;align=center;verticalAlign=middle;fontSize=12;fontStyle=3;" vertex="1" parent="1"><mxGeometry x="400" y="220" width="40" height="20" as="geometry"/></mxCell><mxCell id="n162" value="Fig. Q10 – CFG (N = 8, E = 9)" style="text;html=1;fontFamily=Helvetica;align=center;verticalAlign=middle;fontSize=12;fontStyle=2;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="400" y="690" width="360" height="24" as="geometry"/></mxCell><mxCell id="n163" value="2. Cyclomatic Complexity V(G)" style="text;html=1;fontFamily=Helvetica;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="800" y="70" width="560" height="24" as="geometry"/></mxCell><mxCell id="n164" value="&lt;b&gt;Formula:&lt;/b&gt; V(G) = E − N + 2P &amp;nbsp;&amp;nbsp;(P = connected components = 1)&lt;br&gt;&lt;br&gt;Number of edges &amp;nbsp;&amp;nbsp;E = 9&lt;br&gt;Number of nodes &amp;nbsp;&amp;nbsp;N = 8&lt;br&gt;Predicate (decision) nodes = 2 &amp;nbsp;(while at node 3, if at node 4)&lt;br&gt;Regions R = 3 &amp;nbsp;(R1, R2 inside the graph + R3 outside)&lt;br&gt;&lt;br&gt;&lt;b&gt;Method 1:&lt;/b&gt; V(G) = E − N + 2 = 9 − 8 + 2 = &lt;b&gt;3&lt;/b&gt;&lt;br&gt;&lt;b&gt;Method 2:&lt;/b&gt; V(G) = Predicate nodes + 1 = 2 + 1 = &lt;b&gt;3&lt;/b&gt;&lt;br&gt;&lt;b&gt;Method 3:&lt;/b&gt; V(G) = Number of regions = &lt;b&gt;3&lt;/b&gt;&lt;br&gt;&lt;br&gt;All three methods give &lt;b&gt;V(G) = 3&lt;/b&gt;." style="text;html=1;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;spacing=2;" vertex="1" parent="1"><mxGeometry x="800" y="100" width="560" height="250" as="geometry"/></mxCell><mxCell id="n165" value="3. Independent Paths (Basis Set) and 4. Test Cases" style="text;html=1;fontFamily=Helvetica;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="800" y="370" width="560" height="24" as="geometry"/></mxCell><mxCell id="n166" value="Path" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#E6E6E6;fontColor=#000000;fontStyle=1;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="400" width="60" height="30" as="geometry"/></mxCell><mxCell id="n167" value="Nodes traversed" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#E6E6E6;fontColor=#000000;fontStyle=1;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="860" y="400" width="210" height="30" as="geometry"/></mxCell><mxCell id="n168" value="Test input" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#E6E6E6;fontColor=#000000;fontStyle=1;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1070" y="400" width="130" height="30" as="geometry"/></mxCell><mxCell id="n169" value="Expected output" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#E6E6E6;fontColor=#000000;fontStyle=1;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1200" y="400" width="160" height="30" as="geometry"/></mxCell><mxCell id="n170" value="P1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="430" width="60" height="30" as="geometry"/></mxCell><mxCell id="n171" value="1 → 2 → 3 → 7 → 8" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="860" y="430" width="210" height="30" as="geometry"/></mxCell><mxCell id="n172" value="n = 3" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1070" y="430" width="130" height="30" as="geometry"/></mxCell><mxCell id="n173" value="true" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1200" y="430" width="160" height="30" as="geometry"/></mxCell><mxCell id="n174" value="P2" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="460" width="60" height="30" as="geometry"/></mxCell><mxCell id="n175" value="1 → 2 → 3 → 4 → 5 → 7 → 8" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="860" y="460" width="210" height="30" as="geometry"/></mxCell><mxCell id="n176" value="n = 4" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1070" y="460" width="130" height="30" as="geometry"/></mxCell><mxCell id="n177" value="false" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1200" y="460" width="160" height="30" as="geometry"/></mxCell><mxCell id="n178" value="P3" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="490" width="60" height="30" as="geometry"/></mxCell><mxCell id="n179" value="1 → 2 → 3 → 4 → 6 → 3 → 7 → 8" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="860" y="490" width="210" height="30" as="geometry"/></mxCell><mxCell id="n180" value="n = 5" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1070" y="490" width="130" height="30" as="geometry"/></mxCell><mxCell id="n181" value="true" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1200" y="490" width="160" height="30" as="geometry"/></mxCell><mxCell id="n182" value="Cyclomatic Complexity V(G) = 3&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;3 independent paths → minimum 3 test cases&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="800" y="550" width="560" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>