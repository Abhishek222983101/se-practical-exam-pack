x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e37" value="" style="endArrow=block;endFill=1;endSize=6;html=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n28" target="n29"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n38" value="R1" style="text;html=1;fontFamily=Helvetica;align=center;verticalAlign=middle;fontSize=12;fontStyle=3;" vertex="1" parent="1"><mxGeometry x="480" y="420" width="40" height="20" as="geometry"/></mxCell><mxCell id="n39" value="R2" style="text;html=1;fontFamily=Helvetica;align=center;verticalAlign=middle;fontSize=12;fontStyle=3;" vertex="1" parent="1"><mxGeometry x="600" y="370" width="40" height="20" as="geometry"/></mxCell><mxCell id="n40" value="R3" style="text;html=1;fontFamily=Helvetica;align=center;verticalAlign=middle;fontSize=12;fontStyle=3;" vertex="1" parent="1"><mxGeometry x="700" y="210" width="40" height="20" as="geometry"/></mxCell><mxCell id="n41" value="Fig. Q9 – CFG (N = 7, E = 8)" style="text;html=1;fontFamily=Helvetica;align=center;verticalAlign=middle;fontSize=12;fontStyle=2;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="400" y="580" width="360" height="24" as="geometry"/></mxCell><mxCell id="n42" value="2. Cyclomatic Complexity V(G)" style="text;html=1;fontFamily=Helvetica;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="800" y="70" width="560" height="24" as="geometry"/></mxCell><mxCell id="n43" value="&lt;b&gt;Formula:&lt;/b&gt; V(G) = E − N + 2P &amp;nbsp;&amp;nbsp;(P = connected components = 1)&lt;br&gt;&lt;br&gt;Number of edges &amp;nbsp;&amp;nbsp;E = 8&lt;br&gt;Number of nodes &amp;nbsp;&amp;nbsp;N = 7&lt;br&gt;Predicate (decision) nodes = 2 &amp;nbsp;(nodes 2 and 3)&lt;br&gt;Regions R = 3 &amp;nbsp;(R1, R2 inside the graph + R3 outside)&lt;br&gt;&lt;br&gt;&lt;b&gt;Method 1:&lt;/b&gt; V(G) = E − N + 2 = 8 − 7 + 2 = &lt;b&gt;3&lt;/b&gt;&lt;br&gt;&lt;b&gt;Method 2:&lt;/b&gt; V(G) = Predicate nodes + 1 = 2 + 1 = &lt;b&gt;3&lt;/b&gt;&lt;br&gt;&lt;b&gt;Method 3:&lt;/b&gt; V(G) = Number of regions = &lt;b&gt;3&lt;/b&gt;&lt;br&gt;&lt;br&gt;All three methods give &lt;b&gt;V(G) = 3&lt;/b&gt;." style="text;html=1;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;spacing=2;" vertex="1" parent="1"><mxGeometry x="800" y="100" width="560" height="250" as="geometry"/></mxCell><mxCell id="n44" value="3. Independent Paths (Basis Set) and 4. Test Cases" style="text;html=1;fontFamily=Helvetica;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="800" y="370" width="560" height="24" as="geometry"/></mxCell><mxCell id="n45" value="Path" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#E6E6E6;fontColor=#000000;fontStyle=1;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="400" width="60" height="30" as="geometry"/></mxCell><mxCell id="n46" value="Nodes traversed" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#E6E6E6;fontColor=#000000;fontStyle=1;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="860" y="400" width="210" height="30" as="geometry"/></mxCell><mxCell id="n47" value="Test input" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#E6E6E6;fontColor=#000000;fontStyle=1;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1070" y="400" width="130" height="30" as="geometry"/></mxCell><mxCell id="n48" value="Expected output" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#E6E6E6;fontColor=#000000;fontStyle=1;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1200" y="400" width="160" height="30" as="geometry"/></mxCell><mxCell id="n49" value="P1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" verte