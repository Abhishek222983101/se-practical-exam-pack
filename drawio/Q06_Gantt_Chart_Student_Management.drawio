<mxfile host="app.diagrams.net" type="device"><diagram name="Q6 - Gantt (Version A)" id="d502"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1190" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="Q6. Student Management System – Activities, Dependencies &amp;amp; Gantt Chart (Version A – 17 weeks)" style="text;html=1;fontFamily=Helvetica;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1000" height="30" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;Question:&lt;/b&gt; A college plans to develop a Student Management System to manage student registration, attendance, examination results, and fee details.&lt;br&gt;1. Identify the major project activities and assign suitable durations.&lt;br&gt;2. Define task dependencies and prepare a project schedule using a Gantt chart." style="text;html=1;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;spacing=4;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1000" height="100" as="geometry"/></mxCell><mxCell id="n4" value="1 &amp;amp; 2. Major Activities, Durations and Dependencies" style="text;html=1;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;spacing=0;fontStyle=5;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="1000" height="20" as="geometry"/></mxCell><mxCell id="n5" value="ID" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#E6E6E6;fontColor=#000000;fontStyle=1;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="210" width="60" height="30" as="geometry"/></mxCell><mxCell id="n6" value="Activity" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#E6E6E6;fontColor=#000000;fontStyle=1;strokeColor=#000000;font