<mxfile host="app.diagrams.net" type="device"><diagram name="Q5 - Basic COCOMO" id="d23"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="980" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="Q5. Basic COCOMO – Effort, Time &amp;amp; Cost (20 KLOC, Organic)" style="text;html=1;fontFamily=Helvetica;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1000" height="30" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;Question:&lt;/b&gt; Estimate the development effort and time for a project of size 20 KLOC using the Basic COCOMO model. Assume the project is Organic, with a = 2.4, b = 1.05, c = 2.5, d = 0.38. Calculate the estimated project cost if the development cost is ₹30,000 per person-month." style="text;html=1;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;spacing=4;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1000" height="60" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;Given:&lt;/b&gt;&lt;br&gt;• Size = 20 KLOC &amp;nbsp;&amp;nbsp;• Mode = Organic&lt;br&gt;• a = 2.4, b = 1.05, c = 2.5, d = 0.38&lt;br&gt;• Cost per person-month = ₹30,000" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="1000" height="100" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Formulas:&lt;/b&gt;&lt;br&gt;• Effort &amp;nbsp;E = a × (KLOC)&lt;sup&gt;b&lt;/sup&gt; &amp;nbsp;person-months (PM)&lt;br&gt;• Development time &amp;nbsp;D = c × (E)&lt;sup&gt;d&lt;/sup&gt; &amp;nbsp;months&lt;br&gt;• Average staff &amp;nbsp;N = E / D &amp;nbsp;persons&lt;br&gt;• Cost = E × cost per person-month" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="1000" height="120" as="geometry"/></mxCell><mxCell id="n6" value="Solution" style="text;html=1;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;spacing=0;fontStyle=5;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="1000" height="20" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;Step 1 – Effort&lt;/b&gt;&lt;br&gt;E = 2.4 × (20)&lt;sup&gt;1.05&lt;/sup&gt; = 2.4 × 23.23 = &lt;b&gt;55.76 person-months&lt;/b&gt;" style="text;html=1;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;spacing=4;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="1000" height="60" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;Step 2 – Development Time&lt;/b&gt;&lt;br&gt;D = 2.5 × (55.76)&lt;sup&gt;0.38&lt;/sup&gt; = 2.5 × 4.61 = &lt;b&gt;11.52 months&lt;/b&gt;" style="text;html=1;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;spacing=4;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="1000" height="60" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;Step 3 – Average Staff Size&lt;/b&gt;&lt;br&gt;N = E / D = 55.76 / 11.52 = 4.84 ≈ &lt;b&gt;5 persons&lt;/b&gt;" style="text;html=1;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;spacing=4;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="40" y="550" width="1000" height="60" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;Step 4 – Project Cost&lt;/b&gt;&lt;br&gt;Cost = E × 30,000 = 55.76 × 30,000 = &lt;b&gt;₹16,72,684&lt;/b&gt; (≈ ₹16.73 lakh)" style="text;html=1;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;spacing=4;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="1000" height="60" as="geometry"/></mxCell><mxCell id="n11" value="Result Table" style="text;html=1;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;spacing=0;fontStyle=5;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="1000" height="20" as="geometry"/></mxCell><mxCell id="n12" value="Parameter" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#E6E6E6;fontColor=#000000;fontStyle=1;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="720" width="500" height="30" as="geometry"/></mxCell><mxCell id="n13" value="Value" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#E6E6E6;fontColor=#000000;fontStyle=1;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="540" y="720" width="500" height="30" as="geometry"/></mxCell><mxCell id="n14" value="Effort (E)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="750" width="500" height="30" as="geometry"/></mxCell><mxCell id="n15" value="55.76 person-months" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="540" y="750" width="500" height="30" as="geometry"/></mxCell><mxCell id="n16" value="Development time (D)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="780" width="500" height="30" as="geometry"/></mxCell><mxCell id="n17" value="11.52 months" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="540" y="780" width="500" height="30" as="geometry"/></mxCell><mxCell id="n18" value="Average team size (N)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="810" width="500" height="30" as="geometry"/></mxCell><mxCell id="n19" value="4.84 ≈ 5 persons" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="540" y="810" width="500" height="30" as="geometry"/></mxCell><mxCell id="n20" value="Estimated cost" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="840" width="500" height="30" as="geometry"/></mxCell><mxCell id="n21" value="₹16,72,684 (≈ ₹16.73 lakh)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="540" y="840" width="500" height="30" as="geometry"/></mxCell><mxCell id="n22" value="&lt;b&gt;Final Answer:&lt;/b&gt; Effort ≈ &lt;b&gt;55.76 PM&lt;/b&gt;, Time ≈ &lt;b&gt;11.52 months&lt;/b&gt;, Team ≈ &lt;b&gt;5 persons&lt;/b&gt;, Cost ≈ &lt;b&gt;₹16.73 lakh&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="890" width="1000" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>