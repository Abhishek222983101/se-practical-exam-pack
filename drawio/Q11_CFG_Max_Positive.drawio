etica;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n211" target="n212"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e221" value="T" style="endArrow=block;endFill=1;endSize=6;html=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1" source="n212" target="n213"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint x="-10" y="-6" as="offset"/></mxGeometry></mxCell><mxCell id="e222" value="F" style="endArrow=block;endFill=1;endSize=6;html=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1" source="n212" target="n214"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint x="10" y="-6" as="offset"/></mxGeometry></mxCell><mxCell id="e223" value="" style="endArrow=block;endFill=1;endSize=6;html=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n213" target="n215"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e224" value="" style="endArrow=block;endFill=1;endSize=6;html=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n214" target="n215"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n225" value="R1" style="text;html=1;fontFamily=Helvetica;align=center;verticalAlign=middle;fontSize=12;fontStyle=3;" vertex="1" parent="1"><mxGeometry x="540" y="300" width="40" height="20" as="geometry"/></mxCell><mxCell id="n226" value="R2" style="text;html=1;fontFamily=Helvetica;align=center;verticalAlign=middle;fontSize=12;fontStyle=3;" vertex="1" parent="1"><mxGeometry x="540" y="480" width="40" height="20" as="geometry"/></mxCell><mxCell id="n227" value="R3" style="text;html=1;fontFamily=Helvetica;align=center;verticalAlign=middle;fontSize=12;fontStyle=3;" vertex="1" parent="1"><mxGeometry x="680" y="160" width="40" height="20" as="geometry"/></mxCell><mxCell id="n228" value="Fig. Q11 – CFG (N = 8, E = 9)" style="text;html=1;fontFamily=Helvetica;align=center;verticalAlign=middle;fontSize=12;fontStyle=2;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="400" y="630" width="360" height="24" as="geometry"/></mxCell><mxCell id="n229" value="2. Cyclomatic Complexity V(G)" style="text;html=1;fontFamily=Helvetica;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="800" y="70" width="560" height="24" as="geometry"/></mxCell><mxCell id="n230" value="&lt;b&gt;Formula:&lt;/b&gt; V(G) = E − N + 2P &amp;nbsp;&amp;nbsp;(P = connected components = 1)&lt;br&gt;&lt;br&gt;Number of edges &amp;nbsp;&amp;nbsp;E = 9&lt;br&gt;Number of nodes &amp;nbsp;&amp;nbsp;N = 8&lt;br&gt;Predicate (decision) nodes = 2 &amp;nbsp;(nodes 2 and 5)&lt;br&gt;Regions R = 3 &amp;nbsp;(R1, R2 inside the graph + R3 outside)&lt;br&gt;&lt;br&gt;&lt;b&gt;Method 1:&lt;/b&gt; V(G) = E − N + 2 = 9 − 8 + 2 = &lt;b&gt;3&lt;/b&gt;&lt;br&gt;&lt;b&gt;Method 2:&lt;/b&gt; V(G) = Predicate nodes + 1 = 2 + 1 = &lt;b&gt;3&lt;/b&gt;&lt;br&gt;&lt;b&gt;Method 3:&lt;/b&gt; V(G) = Number of regions = &lt;b&gt;3&lt;/b&gt;&lt;br&gt;&lt;br&gt;All three methods give &lt;b&gt;V(G) = 3&lt;/b&gt;." style="text;html=1;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;spacing=2;" vertex="1" parent="1"><mxGeometry x="800" y="100" width="560" height="250" as="geometry"/></mxCell><mxCell id="n231" value="3. Independent Paths (Basis Set) and 4. Test Cases" style="text;html=1;fontFamily=Helvetica;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="800" y="370" width="560" height="24" as="geometry"/></mxCell><mxCell id="n232" value="Path" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#E6E6E6;fontColor=#000000;fontStyle=1;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="400" width="60" height="30" as="geometry"/></mxCell><mxCell id="n233" value="Nodes traversed" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#E6E6E6;fontColor=#000000;fontStyle=1;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="860" y="400" width="210" height="30" as="geometry"/></mxCell><mxCell id="n234" value="Test input" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#E6E6E6;fontColor=#000000;fontStyle=1;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1070" y="400" width="130" height="30" as="geometry"/></mxCell><mxCell id="n235" value="Expected output" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#E6E6E6;fontColor=#000000;fontStyle=1;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1200" y="400" width="160" height="30" as="geometry"/></mxCell><mxCell id="n236" value="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="430" width="60" height="30" as="geometry"/></mxCell><mxCell id="n237" value="1 → 2 → 3 → 5 → 6 → 8" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="860" y="430" width="210" height="30" as="geometry"/></mxCell><mxCell id="n238" value="a = 5, b = 3" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1070" y="430" width="130" height="30" as="geometry"/></mxCell><mxCell id="n239" value="Positive" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1200" y="430" width="160" height="30" as="geometry"/></mxCell><mxCell id="n240" value="2" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="460" width="60" height="30" as="geometry"/></mxCell><mxCell id="n241" value="1 → 2 → 4 → 5 → 6 → 8" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="860" y="460" width="210" height="30" as="geometry"/></mxCell><mxCell id="n242" value="a = 3, b = 5" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1070" y="460" width="130" height="30" as="geometry"/></mxCell><mxCell id="n243" value="Positive" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1200" y="460" width="160" height="30" as="geometry"/></mxCell><mxCell id="n244" value="3" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="490" width="60" height="30" as="geometry"/></mxCell><mxCell id="n245" value="1 → 2 → 3 → 5 → 7 → 8" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="860" y="490" width="210" height="30" as="geometry"/></mxCell><mxCell id="n246" value="a = −1, b = −5" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1070" y="490" width="130" height="30" as="geometry"/></mxCell><mxCell id="n247" value="Non-positive" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1200" y="490" width="160" height="30" as="geometry"/></mxCell><mxCell id="n248" value="Cyclomatic Complexity V(G) = 3&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;3 independent paths → minimum 3 test cases&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="800" y="550" width="560" height="70" as="geometry"/></mxCell><mxCell id="n249" value="Note: the 4th path 1 → 2 → 4 → 5 → 7 → 8 is a combination of the above paths, so it is not independent." style="text;html=1;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;spacing=2;" vertex="1" parent="1"><mxGeometry x="800" y="640" width="560" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>