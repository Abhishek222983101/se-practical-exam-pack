<mxfile host="app.diagrams.net" type="device"><diagram name="Q11 – CJ" id="d250"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n185" value="Q11. Basis Path Testing – CFG, Cyclomatic Complexity, Independent Paths, Test Cases" style="text;html=1;fontFamily=Helvetica;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1300" height="30" as="geometry"/></mxCell><mxCell id="n186" value="Given program" style="text;html=1;fontFamily=Helvetica;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="320" height="24" as="geometry"/></mxCell><mxCell id="n187" value="read&amp;nbsp;a,&amp;nbsp;b&lt;br&gt;if&amp;nbsp;(a&amp;nbsp;&gt;&amp;nbsp;b)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;max&amp;nbsp;=&amp;nbsp;a&lt;br&gt;else&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;max&amp;nbsp;=&amp;nbsp;b&lt;br&gt;if&amp;nbsp;(max&amp;nbsp;&gt;&amp;nbsp;0)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;print&amp;nbsp;&quot;Positive&quot;&lt;br&gt;else&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;print&amp;nbsp;&quot;Non-positive&quot;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;align=left;verticalAlign=top;fontFamily=Courier New;fontSize=12;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="320" height="200" as="geometry"/></mxCell><mxCell id="n188" value="Node – statement mapping" style="text;html=1;fontFamily=Helvetica;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="320" height="24" as="geometry"/></mxCell><mxCell id="n189" value="Node" style="rounded=0;whiteSpace=wrap;html=