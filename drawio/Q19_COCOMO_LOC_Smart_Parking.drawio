<mxfile host="app.diagrams.net" type="device"><diagram name="Q19 - COCOMO &amp; LOC" id="d25"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1120" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="Q19. Smart Parking Management System – Basic COCOMO &amp;amp; LOC Method" style="text;html=1;fontFamily=Helvetica;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1000" height="30" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;Question:&lt;/b&gt; A municipal corporation plans to develop a Smart Parking Management System (locate parking spaces, reserve slots, online payments, real-time updates; admins monitor occupancy and generate daily reports). Size = 28 KLOC, Organic. a = 2.4, b = 1.05, c = 2.5, d = 0.38.&lt;br&gt;1. Calculate the project effort and development time using Basic COCOMO.&lt;br&gt;2. If productivity is 600 LOC per person-month, calculate the effort using the LOC method." style="text;html=1;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;spacing=4;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1000" height="100" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;Given:&lt;/b&gt;&lt;br&gt;• Size = 28 KLOC = 28,000 LOC &amp;nbsp;&amp;nbsp;• Mode = Organic&lt;br&gt;• a = 2.4, b = 1.05, c = 2.5, d = 0.38&lt;br&gt;• Productivity = 600 LOC / person-month" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="1000" height="100" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Formulas:&lt;/b&gt;&lt;br&gt;• Effort &amp;nbsp;E = a × (KLOC)&lt;sup&gt;b&lt;/sup&gt; &amp;nbsp;PM&lt;br&gt;• Development time &amp;nbsp;D = c × (E)&lt;sup&gt;d&lt;/sup&gt; &amp;nbsp;months&lt;br&gt;• Average staff = E / D&lt;br&gt;• LOC method: Effort = Size (LOC) / Productivity (LOC per PM)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="1000" height="120" as="geometry"/></mxCell><mxCell id="n6" value="Part 1 – Basic COCOMO" style="text;html=1;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;spacing=0;fontStyle=5;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="1000" height="20" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;Step 1 – Effort&lt;/b&gt;&lt;br&gt;E = 2.4 × (28)&lt;sup&gt;1.05&lt;/sup&gt; = 2.4 × 33.08 = &lt;b&gt;79.38 person-months&lt;/b&gt;" style="text;html=1;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;spacing=4;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="1000" height="60" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;Step 2 – Development Time&lt;/b&gt;&lt;br&gt;D = 2.5 × (79.38)&lt;sup&gt;0.38&lt;/sup&gt; = 2.5 × 5.27 = &lt;b&gt;13.18 months&lt;/b&gt;" style="text;html=1;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;spacing=4;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="1000" height="60" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;Step 3 – Average Staff&lt;/b&gt;&lt;br&gt;N = E / D = 79.38 / 13.18 = 6.02 ≈ &lt;b&gt;6 persons&lt;/b&gt;" style="text;html=1;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;spacing=4;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="40" y="590" width="1000" height="60" as="geometry"/></mxCell><mxCell id="n10" value="Part 2 – LOC Method" style="text;html=1;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;spacing=0;fontStyle=5;" vertex="1" parent="1"><mxGeometry x="40" y="660" width="1000" height="20" as="geometry"/></mxCell><mxCell id="n11" value="Effort = 28,000 LOC ÷ 600 LOC per PM = &lt;b&gt;46.67 person-months&lt;/b&gt;" style="text;html=1;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;spacing=4;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="1000" height="40" as="geometry"/></mxCell><mxCell id="n12" value="Result Table" style="text;html=1;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;spacing=0;fontStyle=5;" vertex="1" parent="1"><mxGeometry x="40" y="740" width="1000" height="20" as="geometry"/></mxCell><mxCell id="n13" value="Question" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#E6E6E6;fontColor=#000000;fontStyle=1;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="770" width="500" height="30" as="geometry"/></mxCell><mxCell id="n14" value="Result" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#E6E6E6;fontColor=#000000;fontStyle=1;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="540" y="770" width="500" height="30" as="geometry"/></mxCell><mxCell id="n15" value="Q1: COCOMO effort" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="500" height="30" as="geometry"/></mxCell><mxCell id="n16" value="79.38 person-months" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="540" y="800" width="500" height="30" as="geometry"/></mxCell><mxCell id="n17" value="Q1: Development time" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="830" width="500" height="30" as="geometry"/></mxCell><mxCell id="n18" value="13.18 months" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="540" y="830" width="500" height="30" as="geometry"/></mxCell><mxCell id="n19" value="Q1: Average team size" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="860" width="500" height="30" as="geometry"/></mxCell><mxCell id="n20" value="≈ 6 persons" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="540" y="860" width="500" height="30" as="geometry"/></mxCell><mxCell id="n21" value="Q2: LOC method effort" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="890" width="500" height="30" as="geometry"/></mxCell><mxCell id="n22" value="46.67 person-months" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="540" y="890" width="500" height="30" as="geometry"/></mxCell><mxCell id="n23" value="&lt;b&gt;Comparison:&lt;/b&gt; COCOMO (79.38 PM) &amp;gt; LOC method (46.67 PM) because COCOMO assumes productivity decreases as project size grows (b &amp;gt; 1), while the LOC method assumes constant productivity." style="text;html=1;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;spacing=4;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="40" y="940" width="1000" height="60" as="geometry"/></mxCell><mxCell id="n24" value="&lt;b&gt;Final Answer:&lt;/b&gt; COCOMO Effort ≈ &lt;b&gt;79.38 PM&lt;/b&gt;, Time ≈ &lt;b&gt;13.18 months&lt;/b&gt;, Staff ≈ &lt;b&gt;6&lt;/b&gt;; LOC-method Effort ≈ &lt;b&gt;46.67 PM&lt;/b&gt;&lt;br&gt;&lt;i&gt;Note: some answer sheets show 78.42 PM / 12.86 months — recomputed exactly, the correct values are 79.38 PM and 13.18 months.&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="1010" width="1000" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>