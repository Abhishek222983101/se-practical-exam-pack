ll id="n43" value="Four phases of the Spiral Model" style="text;html=1;fontFamily=Helvetica;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="110" y="800" width="460" height="30" as="geometry"/></mxCell><mxCell id="n44" value="&lt;b&gt;Why the Spiral Model is suitable&lt;/b&gt;&lt;br&gt;• Changing requirements: modified from faculty / student feedback.&lt;br&gt;• Risk management: server failure, wrong evaluation found early.&lt;br&gt;• Iterative development: system built module by module.&lt;br&gt;• Continuous feedback: users review after each cycle.&lt;br&gt;• Complex system: login, exams, evaluation, results." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="680" y="80" width="600" height="260" as="geometry"/></mxCell><mxCell id="n45" value="&lt;b&gt;Application of spirals&lt;/b&gt;" style="text;html=1;fontFamily=Helvetica;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;spacing=0;" vertex="1" parent="1"><mxGeometry x="680" y="370" width="600" height="30" as="geometry"/></mxCell><mxCell id="n46" value="Spiral" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#E6E6E6;fontColor=#000000;fontStyle=1;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="680" y="400" width="110" height="40" as="geometry"/></mxCell><mxCell id="n47" value="Modules developed" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#E6E6E6;fontColor=#000000;fontStyle=1;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="790" y="400" width="490" height="40" as="geometry"/></mxCell><mxCell id="n48" value="Spiral 1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="680" y="440" wid